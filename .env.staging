# Staging Environment Configuration

# Database
DATABASE_URL=postgresql://mcp_hub_staging:staging_password@staging-db.internal:5432/mcp_hub_staging
DATABASE_POOL_SIZE=10
DATABASE_SSL=true
DATABASE_IDLE_TIMEOUT=30000

# API Server
NODE_ENV=staging
PORT=3000
API_URL=https://staging-api.mcp-hub.internal
WEB_URL=https://staging-app.mcp-hub.internal

# WebSocket
WEBSOCKET_URL=wss://staging-api.mcp-hub.internal
WEBSOCKET_PING_INTERVAL=30000

# Token Encryption
TOKEN_ENCRYPTION_KEY=staging_32_byte_hex_key_placeholder_1234567890ab

# GitHub OAuth (Staging App)
GITHUB_OAUTH_CLIENT_ID=Iv1.staging_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=staging_github_client_secret_placeholder
GITHUB_OAUTH_REDIRECT_URI=https://staging-api.mcp-hub.internal/oauth/github/callback

# Slack OAuth (Staging App)
SLACK_OAUTH_CLIENT_ID=staging_slack_client_id.apps.slack.com
SLACK_OAUTH_CLIENT_SECRET=staging_slack_client_secret_placeholder
SLACK_OAUTH_REDIRECT_URI=https://staging-api.mcp-hub.internal/oauth/slack/callback

# Notion OAuth (Staging App)
NOTION_OAUTH_CLIENT_ID=staging_notion_client_id_placeholder
NOTION_OAUTH_CLIENT_SECRET=staging_notion_client_secret_placeholder
NOTION_OAUTH_REDIRECT_URI=https://staging-api.mcp-hub.internal/oauth/notion/callback

# Monitoring
SENTRY_DSN=https://staging_sentry_key@sentry.io/staging_project_id
LOG_LEVEL=debug

# Security
SESSION_SECRET=staging_session_secret_key_placeholder_12345
CORS_ORIGIN=https://staging-app.mcp-hub.internal

# Push Notifications
EXPO_PUSH_TOKEN_SERVER=https://exp.host/--/api/v2/push/send

# Feature Flags
ENABLE_OAUTH_FLOWS=true
ENABLE_TOKEN_EXPIRATION_ALERTS=true
ENABLE_WEBSOCKET_SYNC=true
ENABLE_DRY_RUN_MODE=true

# Testing
ENABLE_TEST_MODE=true
TEST_GITHUB_TOKEN=ghs_test_staging_token_placeholder
TEST_SLACK_TOKEN=xoxb-test-staging-token-placeholder
TEST_NOTION_TOKEN=secret_test_staging_token_placeholder
