  "keyFeatures": [
    "Connect to any MCP server over stdio or HTTP transports",
    "Discover and browse tools exposed by connected servers",
    "Execute tools with dynamic form generation from JSON Schema",
    "Record macros and chain tool calls into reusable workflows",
    "Schedule automated workflow runs",
    "Full execution history and audit log",
    "OAuth2, bearer token, and secret-based authentication",
    "Real-time event streaming via SSE/WebSocket",
    "Share macros and collaborate in team workspaces",
    "Cross-platform: iOS, Android, and web"
  ],
