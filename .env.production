# Production Environment Configuration

# Database
DATABASE_URL=postgresql://mcp_hub_prod:PROD_PASSWORD_PLACEHOLDER@prod-db.internal:5432/mcp_hub_prod
DATABASE_POOL_SIZE=50
DATABASE_SSL=true
DATABASE_IDLE_TIMEOUT=60000
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_STATEMENT_TIMEOUT=30000

# API Server
NODE_ENV=production
PORT=3000
API_URL=https://api.mcphub-cah4bw3p.manus.space
WEB_URL=https://mcphub-cah4bw3p.manus.space
ALLOWED_ORIGINS=https://mcphub-cah4bw3p.manus.space,https://app.mcphub-cah4bw3p.manus.space

# WebSocket
WEBSOCKET_URL=wss://api.mcphub-cah4bw3p.manus.space
WEBSOCKET_PING_INTERVAL=30000
WEBSOCKET_MAX_CONNECTIONS=10000

# Token Encryption (32-byte hex key - MUST be set in production)
TOKEN_ENCRYPTION_KEY=PROD_32_BYTE_HEX_KEY_PLACEHOLDER_1234567890ab

# GitHub OAuth (Production App)
GITHUB_OAUTH_CLIENT_ID=Iv1.prod_github_client_id_placeholder
GITHUB_OAUTH_CLIENT_SECRET=PROD_GITHUB_CLIENT_SECRET_PLACEHOLDER
GITHUB_OAUTH_REDIRECT_URI=https://api.mcphub-cah4bw3p.manus.space/oauth/github/callback

# Slack OAuth (Production App)
SLACK_OAUTH_CLIENT_ID=prod_slack_client_id.apps.slack.com
SLACK_OAUTH_CLIENT_SECRET=PROD_SLACK_CLIENT_SECRET_PLACEHOLDER
SLACK_OAUTH_REDIRECT_URI=https://api.mcphub-cah4bw3p.manus.space/oauth/slack/callback

# Notion OAuth (Production App)
NOTION_OAUTH_CLIENT_ID=prod_notion_client_id_placeholder
NOTION_OAUTH_CLIENT_SECRET=PROD_NOTION_CLIENT_SECRET_PLACEHOLDER
NOTION_OAUTH_REDIRECT_URI=https://api.mcphub-cah4bw3p.manus.space/oauth/notion/callback

# Monitoring & Observability
SENTRY_DSN=https://prod_sentry_key@sentry.io/prod_project_id
LOG_LEVEL=info
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
OPENTELEMETRY_ENABLED=true
OPENTELEMETRY_TRACE_SAMPLE_RATE=0.1

# Security
SESSION_SECRET=PROD_SESSION_SECRET_KEY_PLACEHOLDER_12345
CORS_ORIGIN=https://mcphub-cah4bw3p.manus.space
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX_REQUESTS=100
ENABLE_HTTPS_REDIRECT=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/mcphub.crt
SSL_KEY_PATH=/etc/ssl/private/mcphub.key

# Push Notifications
EXPO_PUSH_TOKEN_SERVER=https://exp.host/--/api/v2/push/send
PUSH_NOTIFICATION_BATCH_SIZE=100
PUSH_NOTIFICATION_RETRY_ATTEMPTS=3

# Feature Flags
ENABLE_OAUTH_FLOWS=true
ENABLE_TOKEN_EXPIRATION_ALERTS=true
ENABLE_WEBSOCKET_SYNC=true
ENABLE_DRY_RUN_MODE=true
ENABLE_ADMIN_DASHBOARD=true
ENABLE_METRICS_EXPORT=true
ENABLE_AUDIT_LOGGING=true

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=mcp-hub-prod-backups
BACKUP_S3_REGION=us-east-1

# Email Notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SENDGRID_API_KEY_PLACEHOLDER
SMTP_FROM=noreply@mcphub-cah4bw3p.manus.space

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PROD_SLACK_WEBHOOK_PLACEHOLDER
SLACK_ALERT_CHANNEL=#mcp-hub-alerts
SLACK_ALERT_LEVEL=warning

# PagerDuty Integration
PAGERDUTY_INTEGRATION_KEY=PAGERDUTY_KEY_PLACEHOLDER

# Performance & Caching
REDIS_URL=redis://prod-redis.internal:6379/0
REDIS_PASSWORD=PROD_REDIS_PASSWORD_PLACEHOLDER
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000

# Database Replication
DATABASE_REPLICA_URL=postgresql://mcp_hub_prod:PROD_PASSWORD_PLACEHOLDER@prod-db-replica.internal:5432/mcp_hub_prod
DATABASE_REPLICA_ENABLED=true

# Maintenance Windows
MAINTENANCE_WINDOW_START=02:00 # UTC
MAINTENANCE_WINDOW_DURATION_HOURS=1
MAINTENANCE_MODE_ENABLED=false

# Metrics Collection
METRICS_RETENTION_DAYS=90
METRICS_AGGREGATION_INTERVAL_MINUTES=5
METRICS_EXPORT_FORMAT=prometheus

# API Rate Limiting per User
USER_RATE_LIMIT_REQUESTS_PER_HOUR=10000
USER_RATE_LIMIT_WORKFLOWS_PER_HOUR=1000
USER_RATE_LIMIT_TOKENS_PER_HOUR=100

# Workflow Execution
MAX_WORKFLOW_EXECUTION_TIME_SECONDS=3600
MAX_WORKFLOW_STEP_TIMEOUT_SECONDS=300
MAX_CONCURRENT_WORKFLOWS=1000
WORKFLOW_QUEUE_SIZE=50000

# Testing & Debugging (Disabled in Production)
ENABLE_TEST_MODE=false
DEBUG_MODE=false
VERBOSE_LOGGING=false
